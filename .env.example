#============================================================
# CityPulse — Local Environment Template
# Copy this file to .env and provide local values.
# Never commit .env.
#============================================================

# Application
CITYPULSE_ENV=development
DEBUG=true

# Backend
DJANGO_SECRET_KEY=replace-with-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / PostGIS
POSTGRES_DB=citypulse
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO / Object Storage
MINIO_ROOT_USER=replace-with-local-user
MINIO_ROOT_PASSWORD=replace-with-local-password
MINIO_BUCKET=citypulse-local

# S3-compatible storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=citypulse-local
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws