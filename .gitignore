# ============================================================
# CityPulse — Git Ignore
# ============================================================

# ----------------------------
# Environment / Secrets
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# Python
# ----------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Django
*.log
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ----------------------------
# Node / Next.js
# ----------------------------
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------
# IDE / Editors
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# OS
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# Terraform
# ----------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Keep lock file tracked
!.terraform.lock.hcl

# ----------------------------
# Docker / Runtime
# ----------------------------
*.pid

# ----------------------------
# Local data
# ----------------------------
data/
tmp/
temp/

# ----------------------------
# Certificates / Keys
# ----------------------------
*.pem
*.key
*.crt
*.p12
*.pfx

# ----------------------------
# Generated artifacts
# ----------------------------
artifacts/
reports/